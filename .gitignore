# environments
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.DS_Store

# data (large / redistributable only from the original sources)
data/raw/*.h5
data/raw/sensor_graph/*.csv
data/raw/sensor_graph/*.txt
data/raw/sensor_graph/*.pkl
data/processed/*.npz
data/processed/*.npy

# generated artifacts (reproduced by the notebooks)
artifacts/models/*
artifacts/predictions/*
artifacts/figures/*
artifacts/metrics/*
!artifacts/*/.gitkeep
# deep-learning training curves are small and feed the dashboard
!artifacts/metrics/dl_*_history.csv
!artifacts/metrics/dl_*_summary.json
!artifacts/metrics/dl_st_gat_attention.npz
artifacts/metrics/*_smoke_*

# SUMO outputs
phase2/simulation/output/
*.tripinfo.xml
*.queue.xml
